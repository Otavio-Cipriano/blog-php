{
  "name": "app/blog",
  "description": "Blog simples em PHP usando DI e SQLite",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Core\\": "core/"
    }
  },
  "require": {
    "php-di/php-di": "^7.1",
    "twbs/bootstrap": "^5.3.8",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ezyang/htmlpurifier": "^4.19",
    "ext-mbstring": "*"
  },
  "scripts": {
    "copy-bootstrap": "php scripts/copy-bootstrap.php",
    "post-install-cmd": [
      "@copy-bootstrap"
    ],
    "post-update-cmd": [
      "@copy-bootstrap"
    ]
  }
}
